{
  "info": {
    "name": "Koppa API v1",
    "description": "Phase 1 REST collection.\n\n1. Set `baseUrl` (default http://localhost:3000).\n2. Run Auth → Register or Login. Tests save `accessToken` and `refreshToken`.\n3. Admin seed user: `admin@koppa.local` / `ChangeMeAdmin1!` (if seed ran).\n4. After Admin → Create cafe, copy `data.id` into `cafeId`.\n\nBearer is collection-level. Public folders override to No Auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "cafeId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "suggestionId", "value": "" },
    { "key": "questionId", "value": "" },
    { "key": "optionId", "value": "" },
    { "key": "lat", "value": "11.2588" },
    { "key": "lng", "value": "75.7804" }
  ],
  "item": [
    {
      "name": "Health",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "GET health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.tokens.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"naveen@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Naveen\",\n  \"username\": \"naveen\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.tokens.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"naveen@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.tokens.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@koppa.local\",\n  \"password\": \"ChangeMeAdmin1!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.tokens.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Public discovery",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "List categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories"
          }
        },
        {
          "name": "Cafes in category",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/:id/cafes?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", ":id", "cafes"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ],
              "variable": [{ "key": "id", "value": "{{categoryId}}" }]
            }
          }
        },
        {
          "name": "List cafes",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/cafes?page=1&limit=20&q=&category=&place=&feature=&lat={{lat}}&lng={{lng}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cafes"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "q", "value": "", "disabled": true },
                { "key": "category", "value": "work", "disabled": true },
                { "key": "place", "value": "Kozhikode", "disabled": true },
                { "key": "feature", "value": "wifi", "disabled": true },
                { "key": "lat", "value": "{{lat}}" },
                { "key": "lng", "value": "{{lng}}" }
              ]
            }
          }
        },
        {
          "name": "Nearby cafes",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/cafes/nearby?latitude={{lat}}&longitude={{lng}}&radius_km=5&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cafes", "nearby"],
              "query": [
                { "key": "latitude", "value": "{{lat}}" },
                { "key": "longitude", "value": "{{lng}}" },
                { "key": "radius_km", "value": "5" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get cafe",
