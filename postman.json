              "path": ["api", "v1", "cafes", ":id"],
              "query": [
                { "key": "lat", "value": "{{lat}}" },
                { "key": "lng", "value": "{{lng}}" }
              ],
              "variable": [{ "key": "id", "value": "{{cafeId}}" }]
            }
          }
        },
        {
          "name": "List cafe reviews",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/cafes/:id/reviews?page=1&limit=20",
